				"labels": [
					"pw.option.small",
					"pw.option.large"
				]
			},
			"global-padding-bottom": {
				"value": [
					"1.5rem",
					"3rem"
				],
				"unit": "rem",
				"step": 0.1,
				"min": 0,
				"max": 20,
				"suffixes": [
					"-small",
					"-large"
				],
				"labels": [
					"pw.option.small",
					"pw.option.large"
				]
			},
