	"colors": {
		"vars": {
			"body-background": {
				"value": "#E8E8E8",
				"type": "color"
			}
		},
		"colors": {
			"block-background": {
				"default": "#ffffff",
				"variant": "#F5F5F5",
				"variant2": "#1D548B",
				"variant3": "#1D548B"
			},
			"block-link": {
				"default": "#1D548B",
				"variant": "#1D548B",
				"variant2": "#8CBAE7",
				"variant3": "#8CBAE7"
			},
			"block-link-hover": {
				"default": "#1A4E7A",
				"variant": "#1A4E7A",
				"variant2": "#7AA9D0",
				"variant3": "#7AA9D0"
			},
			"block-link-active": {
				"default": "#163F5C",
				"variant": "#163F5C",
				"variant2": "#6680A8",
				"variant3": "#6680A8"
			}
		}
	},
	"links": {
		"vars": {
			"block-link-decoration": {
				"value": "none",
				"options": [
					"none",
					"always",
					"hover"
				],
				"type": "toggle-pair",
				"generates": {
					"block-link-decoration": {
						"none": "none",
						"always": "underline",
						"hover": "none"
					},
					"block-link-decoration-hover": {
						"none": "none",
						"always": "underline",
						"hover": "underline"
					}
				}
			},
			"block-link-weight": {
				"value": "normal",
				"options": [
					"normal",
					"bold"
				],
				"type": "toggle-pair",
				"generates": {
					"block-link-font-weight": {
						"normal": "inherit",
						"bold": "700"
					},
					"block-link-cta-font-weight": {
						"normal": "500",
						"bold": "700"
					}
				}
			},
			"block-link-thickness": {
				"value": "1px",
				"unit": "px",
				"step": 1,
				"min": 1,
				"max": 4
			},
			"block-link-offset": {
				"value": "0.2em",
				"unit": "em",
				"step": 0.05,
				"min": 0,
				"max": 1
			}
		}
	}
}
